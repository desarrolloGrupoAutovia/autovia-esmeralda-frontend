# Autovía Esmeralda - Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# URL de autovia-dashboard (backend real, otro repo/proyecto de Vercel).
# Por defecto apunta a producción. Para probar contra el backend corriendo
# en local (npx vercel dev en autovia-dashboard), descomenta y ajusta el
# puerto con el que lo levantaste:
# VITE_DASHBOARD_URL=http://localhost:40000
